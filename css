/* =========================================================
   PAGE SETUP
========================================================= */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background: #ffffff;
    color: #202020;
    font-family: Georgia, "Times New Roman", serif;
    line-height: 1.65;
}


/* =========================================================
   MAIN STORY COLUMN
========================================================= */

.story {
    width: min(100% - 40px, 860px);
    margin: 0 auto;
    padding: 64px 0 80px;
}


/* =========================================================
   TYPOGRAPHY
========================================================= */

h1,
h2,
p {
    margin-top: 0;
}

h1 {
    max-width: 820px;
    margin-bottom: 24px;
    font-size: clamp(3rem, 8vw, 6.6rem);
    line-height: 0.94;
    letter-spacing: -0.055em;
    font-weight: 700;
}

h2 {
    margin-bottom: 14px;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 1.6rem;
    line-height: 1.25;
}

p {
    margin-bottom: 20px;
    font-size: 1.13rem;
}

.dek {
    max-width: 720px;
    margin-bottom: 24px;
    font-size: clamp(1.25rem, 2.5vw, 1.65rem);
    line-height: 1.4;
}

.lead {
    font-size: 1.3rem;
    line-height: 1.55;
}

.eyebrow {
    margin-bottom: 8px;
    color: #b43b36;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.byline {
    margin: 0;
    color: #666666;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.98rem;
}


/* =========================================================
   HEADER
========================================================= */

.story-header {
    margin-bottom: 42px;
    padding-bottom: 36px;
    border-bottom: 1px solid #dddddd;
}


/* =========================================================
   OPENING STATISTICS
========================================================= */

.opening-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;

    margin: 40px 0;
    padding: 28px 0;

    border-top: 3px solid #202020;
    border-bottom: 1px solid #dddddd;

    font-family: Arial, Helvetica, sans-serif;
}

.stat {
    display: flex;
    flex-direction: column;
}

.stat strong {
    font-size: 2.8rem;
    line-height: 1;
    letter-spacing: -0.04em;
}

.stat span {
    margin-top: 8px;
    color: #666666;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}


/* =========================================================
   STORY SECTIONS
========================================================= */

.story-section,
.chart-section,
.context-section,
.methodology {
    margin: 60px 0;
}

.intro {
    max-width: 760px;
}

.section-heading {
    max-width: 720px;
    margin-bottom: 18px;
}

.chart-intro {
    max-width: 720px;
    color: #444444;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 1rem;
}


/* =========================================================
   CHART IMAGES
========================================================= */

.chart-figure {
    margin: 35px 0 30px;
}

.chart-figure img {
    display: block;
    width: 100%;
    height: auto;

    border-top: 1px solid #dddddd;
    border-bottom: 1px solid #dddddd;
}

.chart-figure figcaption {
    margin-top: 10px;

    color: #666666;

    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.82rem;
    line-height: 1.45;
}


/* =========================================================
   AIRPORT HIGHLIGHT BOX
========================================================= */

.highlight-box {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;

    margin: 35px 0;
    border-top: 1px solid #dddddd;
    border-bottom: 1px solid #dddddd;

    font-family: Arial, Helvetica, sans-serif;
}

.highlight-box div {
    padding: 25px 20px;
    border-bottom: 1px solid #dddddd;
}

.highlight-box div:nth-child(odd) {
    border-right: 1px solid #dddddd;
}

.highlight-box strong {
    display: block;

    font-size: 2rem;
    line-height: 1;
}

.highlight-box span {
    display: block;

    margin-top: 8px;

    color: #666666;
    font-size: 0.85rem;
}


/* =========================================================
   PASSENGER SECTION
========================================================= */

.passenger-section {
    padding: 35px 0;

    border-top: 3px solid #202020;
    border-bottom: 1px solid #dddddd;
}


/* =========================================================
   CONTEXT / 42 CRORE
========================================================= */

.context-section {
    padding: 35px 0;
    border-bottom: 1px solid #dddddd;
}

.big-number {
    margin: 15px 0 5px;

    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.06em;
}

.big-number-label {
    max-width: 550px;

    color: #555555;

    font-family: Arial, Helvetica, sans-serif;
    font-size: 1rem;
}


/* =========================================================
   REPORTING QUESTION
========================================================= */

.callout {
    margin: 70px 0;

    padding: 30px 0;

    border-top: 3px solid #202020;
    border-bottom: 1px solid #dddddd;
}

.callout-text {
    max-width: 760px;

    margin-bottom: 0;

    font-size: 1.6rem;
    line-height: 1.4;
}


/* =========================================================
   EVIDENCE SECTION
========================================================= */

.evidence-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px;

    margin: 60px 0;
    padding: 34px 0;

    border-top: 1px solid #dddddd;
    border-bottom: 1px solid #dddddd;
}

.evidence-grid p {
    margin-bottom: 0;
    font-size: 1rem;
}


/* =========================================================
   METHODOLOGY
========================================================= */

.methodology {
    padding: 30px;

    background: #f6f6f6;

    border-left: 4px solid #b43b36;
}

.methodology p {
    font-size: 0.98rem;
}

.methodology p:last-child {
    margin-bottom: 0;
}


/* =========================================================
   FOOTER
========================================================= */

.story-footer {
    margin-top: 58px;
    padding-top: 22px;

    border-top: 1px solid #dddddd;

    color: #5e5e5e;

    font-family: Arial, Helvetica, sans-serif;
}

.story-footer p {
    margin-bottom: 8px;
    font-size: 0.9rem;
}


/* =========================================================
   LINKS
========================================================= */

a {
    color: #9c2f2b;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 640px) {

    .story {
        width: min(100% - 32px, 860px);
        padding-top: 38px;
    }

    h1 {
        font-size: clamp(3rem, 16vw, 4.6rem);
    }

    .dek {
        font-size: 1.18rem;
    }

    p,
    .lead {
        font-size: 1rem;
    }

    .opening-stats {
        grid-template-columns: 1fr;
        gap: 25px;
    }

    .stat strong {
        font-size: 2.4rem;
    }

    .story-section,
    .chart-section,
    .context-section,
    .methodology {
        margin: 40px 0;
    }

    .highlight-box {
        grid-template-columns: 1fr;
    }

    .highlight-box div:nth-child(odd) {
        border-right: none;
    }

    .evidence-grid {
        grid-template-columns: 1fr;
        gap: 30px;
    }

    .callout-text {
        font-size: 1.25rem;
    }

    .methodology {
        padding: 22px;
    }
}